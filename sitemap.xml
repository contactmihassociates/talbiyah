<?xml version="1.0" encoding="UTF-8"?>
<!-- Single-page site. `set-domain.py` replaces www.talbiyah.in
     here and everywhere else.

     <lastmod> matters most at exactly one moment: when the season's prices and
     dates change. That is the point to bump it, because it tells Google to
     re-crawl a page whose most important numbers just moved. Google ignores
     lastmod values it finds unreliable, so a date left stale for months is
     worse than none — either keep it honest at each season change or drop the
     element. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.talbiyah.in/</loc>
    <lastmod>2026-09-25</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
